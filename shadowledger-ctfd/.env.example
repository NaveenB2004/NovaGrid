# Copy this file to .env and fill in real values before first `docker compose up`.
# NEVER commit the real .env to git — .gitignore already excludes it.

# MariaDB
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_$(openssl rand -hex 12)
MYSQL_PASSWORD=CHANGE_ME_CTFD_$(openssl rand -hex 12)

# CTFd application secret key — used to sign session cookies.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
CTFD_SECRET_KEY=CHANGE_ME_64_HEX_CHARS
